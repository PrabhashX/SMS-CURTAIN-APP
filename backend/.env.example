# Fill these values in on your backend server. NEVER include .env in the APK.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sms_curtains
JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PORT=8080
# Demo credentials you requested. Change both before internet deployment!
ADMIN_PASSWORD=admin
EMPLOYEE_PASSWORD=employee
# NODE_ENV=production requires stronger credentials.
NODE_ENV=development
